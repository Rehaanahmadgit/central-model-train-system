.dev-data/

# Python
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Backend virtualenv
backend/.venv/

# Frontend
frontend/node_modules/
frontend/dist/

# Editor-local files (machine-specific paths; not project config)
.vscode/
