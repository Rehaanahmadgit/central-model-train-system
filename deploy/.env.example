# TrainHub — copy-paste ready environment for docker compose [doc 16 DIST-03].
# Copy to deploy/.env (gitignored) and edit. Values override the compose defaults.

# Workspace root inside the container. Leave at /data (the named volume).
TRAINHUB_HOME=/data

# Device: auto | cpu | cuda | cuda:N [doc 14 §3.1]. On a GPU server use `auto`.
TRAINHUB_DEVICE=auto

# Shared access token — SET THIS if the instance is reachable beyond localhost.
# Identifies nobody [doc 10 §2]; rotate by changing this value.
TRAINHUB_ACCESS_TOKEN=

# Which host the app binds to (0.0.0.0 = all interfaces). Local-only: 127.0.0.1.
TRAINHUB_BIND_HOST=0.0.0.0

# Optional overrides:
# TRAINHUB_MAX_CPU_JOBS=1
# TRAINHUB_LOG_LEVEL=INFO
