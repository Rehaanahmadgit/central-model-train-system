# TrainHub configuration [doc 10 §9].
# Copy to backend/.env (gitignored) to override for local development.
# Every value is read via pydantic-settings with the TRAINHUB_ prefix.

# Workspace root: all state lives here [doc 04 §1].
# Local dev: ./.dev-data (relative to backend/, gitignored). Docker image sets /data.
TRAINHUB_HOME=./.dev-data

# Device abstraction: auto | cpu | cuda | cuda:N [doc 14 §3.1]. Laptop default: cpu.
TRAINHUB_DEVICE=cpu

# Optional single shared access token; identifies nobody [doc 10 §2].
# TRAINHUB_ACCESS_TOKEN=

# TRAINHUB_LOG_LEVEL=DEBUG
